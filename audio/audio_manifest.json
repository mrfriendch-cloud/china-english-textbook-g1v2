      "type": "vocabulary"
    },
    "u6_dlg_1": {
      "text": "Put on your shirt.",
      "translation": "穿上你的衬衫。",
      "file": "audio/u6_dlg_1.mp3",
      "type": "dialogue"
    },
    "u6_dlg_2": {
      "text": "Take off your socks.",
      "translation": "脱下你的短袜。",
      "file": "audio/u6_dlg_2.mp3",
      "type": "dialogue"
    },
    "u6_dlg_3": {
      "text": "I like your dress.",
      "translation": "我喜欢你的连衣裙。",
      "file": "audio/u6_dlg_3.mp3",
      "type": "dialogue"
    },
    "u6_dlg_4": {
      "text": "Thank you.",
      "translation": "谢谢你。",
      "file": "audio/u6_dlg_4.mp3",
      "type": "dialogue"
    },
    "u6_dlg_5": {
      "text": "Is this your T-shirt?",
      "translation": "这是你的T恤衫吗？",
      "file": "audio/u6_dlg_5.mp3",
      "type": "dialogue"
    },
    "u6_dlg_6": {
      "text": "Yes, it is.",
      "translation": "是的，它是。",
      "file": "audio/u6_dlg_6.mp3",
      "type": "dialogue"
