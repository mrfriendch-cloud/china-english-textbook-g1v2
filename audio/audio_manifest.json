    "u4_dlg_1": {
      "text": "I'm hungry.",
      "translation": "我饿了。",
      "file": "audio/u4_dlg_1.mp3",
      "type": "dialogue"
    },
    "u4_dlg_2": {
      "text": "I want rice and chicken.",
      "translation": "我想吃米饭和鸡肉。",
      "file": "audio/u4_dlg_2.mp3",
      "type": "dialogue"
    },
    "u4_dlg_3": {
      "text": "What do you want?",
      "translation": "你想要什么？",
      "file": "audio/u4_dlg_3.mp3",
      "type": "dialogue"
    },
    "u4_dlg_4": {
      "text": "I want noodles.",
      "translation": "我想要面条。",
      "file": "audio/u4_dlg_4.mp3",
      "type": "dialogue"
    },
    "u4_dlg_5": {
      "text": "Do you like fish?",
      "translation": "你喜欢鱼肉吗？",
      "file": "audio/u4_dlg_5.mp3",
      "type": "dialogue"
    },
    "u4_dlg_6": {
      "text": "Yes, I do.",
      "translation": "是的，我喜欢。",
      "file": "audio/u4_dlg_6.mp3",
      "type": "dialogue"
    },
