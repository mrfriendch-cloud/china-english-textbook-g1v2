    "u1_dlg_1": {
      "text": "Where is the cat?",
      "translation": "猫在哪里？",
      "file": "audio/u1_dlg_1.mp3",
      "type": "dialogue"
    },
    "u1_dlg_2": {
      "text": "It's on the chair.",
      "translation": "它在椅子上。",
      "file": "audio/u1_dlg_2.mp3",
      "type": "dialogue"
    },
    "u1_dlg_3": {
      "text": "Where is the ruler?",
      "translation": "尺子在哪里？",
      "file": "audio/u1_dlg_3.mp3",
      "type": "dialogue"
    },
    "u1_dlg_4": {
