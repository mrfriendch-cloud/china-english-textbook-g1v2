    "u2_dlg_1": {
      "text": "What's in your room?",
      "translation": "你的房间里有什么？",
      "file": "audio/u2_dlg_1.mp3",
      "type": "dialogue"
    },
    "u2_dlg_2": {
      "text": "A bed, a light and a desk.",
      "translation": "一张床、一盏灯和一张书桌。",
      "file": "audio/u2_dlg_2.mp3",
      "type": "dialogue"
    },
    "u2_dlg_3": {
      "text": "Where is the light?",
      "translation": "灯在哪里？",
      "file": "audio/u2_dlg_3.mp3",
      "type": "dialogue"
    },
    "u2_dlg_4": {
      "text": "It's near the window.",
      "translation": "它在窗户附近。",
      "file": "audio/u2_dlg_4.mp3",
      "type": "dialogue"
    },
    "u2_dlg_5": {
      "text": "Where is the box?",
      "translation": "盒子在哪里？",
      "file": "audio/u2_dlg_5.mp3",
      "type": "dialogue"
    },
    "u2_dlg_6": {
      "text": "It's behind the door.",
      "translation": "它在门后面。",
