    "u5_thanks": {
      "text": "thanks",
      "translation": "感谢",
      "file": "audio/u5_thanks.mp3",
      "type": "vocabulary"
    },
    "u5_dlg_1": {
      "text": "I'm thirsty.",
      "translation": "我口渴了。",
      "file": "audio/u5_dlg_1.mp3",
      "type": "dialogue"
    },
    "u5_dlg_2": {
      "text": "I want water.",
      "translation": "我想喝水。",
      "file": "audio/u5_dlg_2.mp3",
      "type": "dialogue"
    },
    "u5_dlg_3": {
      "text": "Can I have some milk?",
      "translation": "我可以喝点牛奶吗？",
      "file": "audio/u5_dlg_3.mp3",
      "type": "dialogue"
    },
    "u5_dlg_4": {
      "text": "Here you are.",
      "translation": "给你。",
      "file": "audio/u5_dlg_4.mp3",
      "type": "dialogue"
    },
    "u5_dlg_5": {
      "text": "Thanks.",
      "translation": "谢谢。",
      "file": "audio/u5_dlg_5.mp3",
      "type": "dialogue"
    },
