    "u3_dlg_1": {
      "text": "Can I have a car?",
      "translation": "我可以要辆小汽车吗？",
      "file": "audio/u3_dlg_1.mp3",
      "type": "dialogue"
    },
    "u3_dlg_2": {
      "text": "Sure. Here you are.",
      "translation": "当然可以。给你。",
      "file": "audio/u3_dlg_2.mp3",
      "type": "dialogue"
    },
    "u3_dlg_3": {
      "text": "Can I have a plane?",
      "translation": "我可以要架飞机吗？",
      "file": "audio/u3_dlg_3.mp3",
      "type": "dialogue"
    },
    "u3_dlg_4": {
      "text": "Sorry, no.",
      "translation": "对不起，不行。",
      "file": "audio/u3_dlg_4.mp3",
      "type": "dialogue"
    },
    "u3_dlg_5": {
      "text": "I have a bear.",
